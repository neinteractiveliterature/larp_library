# Copy this to .env for local development. Everything the server reads is validated in app/server/env.ts.

DATABASE_URL=postgres://localhost/larp_library_development

# Any long random string
BETTER_AUTH_SECRET=development-secret-change-me-development-secret
# Where the app is served, for the links in emails and the sign-in callback
APP_URL_BASE=http://localhost:3042
BETTER_AUTH_URL=http://localhost:3042

# Signing in goes through Intercode. Register an OAuth application there with the redirect URI
# http://localhost:3042/api/auth/callback/intercode and put its id and secret here.
INTERCODE_URL=https://www.neilhosting.net
INTERCODE_APP_ID=
INTERCODE_APP_SECRET=

# Email: a local SMTP catcher (e.g. Mailpit on port 1025) so nothing is really sent in development
SMTP_URL=smtp://localhost:1025

# File uploads go to this S3 bucket; the AWS SDK finds credentials the usual ways (environment, AWS_PROFILE...)
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# For the tests (each test worker makes its own database on this server)
TEST_DATABASE_URL=postgres://localhost/larp_library_test
