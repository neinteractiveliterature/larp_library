{
  "compilerOptions": {
    "outDir": "./dist/", // path to output directory
    "sourceMap": true, // allow sourcemap support
    "strictNullChecks": true, // enable strict null checks as a best practice
    "module": "esnext", // specify module code generation
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./app/*"] // how the tests import the app's code
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"], // lets route modules import their generated ./+types/* files
    "jsx": "react-jsx", // use typescript to transpile jsx to js
    "target": "es6", // specify ECMAScript target version
    "allowJs": true, // allow a partial TypeScript and JavaScript codebase,
    "allowSyntheticDefaultImports": true,
    "typeRoots": [
      "node_modules/@types",
      "app/@types",
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": [
    "./app/",
    "./app/.server/**/*",
    "./test/",
    "./.react-router/types/**/*",
    ".eslintrc.js"
  ],
  "exclude": [
    // generated by the test run (the HTML report includes JavaScript)
    "./test/reports",
    "./test/html_reports"
  ]
}
