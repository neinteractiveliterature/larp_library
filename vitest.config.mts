import { defineConfig } from 'vitest/config';
import react from '@vitejs/plugin-react';
import { fileURLToPath } from 'node:url';

function absolutePath(relativePath: string) {
  return fileURLToPath(new URL(relativePath, import.meta.url));
}

// Deliberately separate from vite.config.mts: tests don't need vite-plugin-ruby or the asset-host build hooks
export default defineConfig({
  plugins: [react()],
  test: {
    coverage: {
      enabled: process.env['COVERAGE'] ? true : false,
      include: ['app/javascript/**/*.{ts,tsx}'],
      exclude: [
        // generated by graphql-codegen
        'app/javascript/**/*.generated.ts',
        // codegen inputs: the app imports the generated hooks and documents, not these gql declarations (only
        // Project/queries.ts is also loaded at runtime, for a fragment and one query used by the S3 upload code)
        'app/javascript/**/queries.ts',
        'app/javascript/**/mutations.ts',
        'app/javascript/TagCategories/TagCategoryFragment.ts',
        // the app entry point, which boots React into the DOM on window load, and ambient type declarations
        'app/javascript/packs/**',
        'app/javascript/@types/**',
      ],
      reportsDirectory: absolutePath('./coverage'),
      reporter: ['text', 'cobertura', 'html'],
      reportOnFailure: true,
    },
    // Some page code awaits a mutation without catching a failure, which is an unhandled rejection in the browser (see
    // InvitationPage).  Vitest fails the whole run on those, even when every test passed.  Tests that deliberately
    // exercise such a path throw an error whose message contains the marker below; anything else still fails the run.
    onUnhandledError(error) {
      try {
        if (JSON.stringify(error).includes('[expected unhandled]')) {
          return false;
        }
      } catch {
        // fall through: report errors we can't inspect
      }
      return undefined;
    },
    environment: 'jsdom',
    globals: true,
    setupFiles: [absolutePath('./test/javascript/setupTests.ts')],
    include: ['app/javascript/**/*.test.{ts,tsx}', 'test/javascript/**/*.test.{ts,tsx}'],
    testTimeout: 10000,
    reporters: [
      'default',
      ['junit', { outputFile: absolutePath('./test/reports/TEST-vitest.xml') }],
      ['html', { outputFile: absolutePath('./test/html_reports/vitest-report.html') }],
    ],
    server: {
      deps: {
        // litform's ES build imports "@apollo/client/link/error" as a directory, which Node's ESM resolver rejects but
        // Vite's accepts, so litform has to go through Vite.
        //
        // The Testing Library packages have to be processed together so that they all share one copy of
        // @testing-library/dom.  Otherwise user-event ends up with its own copy, which React Testing Library hasn't
        // configured to wrap events in act(), and every user interaction logs "not wrapped in act(...)" warnings.
        inline: [
          '@neinteractiveliterature/litform',
          '@testing-library/dom',
          '@testing-library/react',
          '@testing-library/user-event',
        ],
      },
    },
  },
});
