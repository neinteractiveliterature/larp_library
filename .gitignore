# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

.DS_Store

# Local config files
/.env
/.env.*.local

# Build artifacts (the two under public/ are what the Rails version of the app built, and may linger in an old checkout)
/public/assets
/public/packs
/stats.json

# Yarn stuff for non-zeroinstall setup
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

/.vscode/settings.json
/dist
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
*.pgdump
/*.sql
/*.sql.gz
/stats.json
/workspaceConfiguration
/tmp
/log

# Frontend test output
/coverage
/test/reports
/test/html_reports
/.vitest

# React Router build output
/build
/.react-router

# SST
/.sst
